# ============================================================
# sync_whitelist configuration
# Copy to .env (loaded automatically via python-dotenv) or export
# these as real environment variables in your shell / scheduler.
# Real environment variables take priority over .env values.
# ============================================================

# ---- REQUIRED ----------------------------------------------------
# GitHub Personal Access Token with write access to DEPLOY_REPO.
GH_PAT=

# Destination GitHub repository (owner/name) for the generated artifacts.
DEPLOY_REPO=yourname/sing-box-src

# ---- sing-box ----------------------------------------------------
# Leave SING_BOX_PATH empty to auto-download sing-box from the
# SagerNet/sing-box GitHub releases (OS/arch detected automatically:
# windows/linux, amd64/arm64/386). Binary is cached in work/bin/.
# Or point it at an existing binary:
#   Windows: C:\tools\sing-box\sing-box.exe
#   Linux:   /usr/local/bin/sing-box
SING_BOX_PATH=

# Release to download: "latest" or a pinned version like 1.14.0
SING_BOX_VERSION=latest

# Set 1 to force re-download even if a cached binary exists
SING_BOX_FORCE_DOWNLOAD=0

# ---- deployment ----------------------------------------------------
DEPLOY_BRANCH=main
# Subdirectory inside DEPLOY_REPO ("" = repo root)
DEPLOY_DIR=

# ---- source --------------------------------------------------------
WORK_DIR=
SRC_REPO=hxehex/russia-mobile-internet-whitelist
SRC_BRANCH=main

# ---- rule-set generation -------------------------------------------
# sing-box rule-set "version" field. 5 requires sing-box >= 1.14.0.
RULESET_VERSION=5
NO_COMPILE=0

# ---- run mode ------------------------------------------------------
# DAEMON=1 equals: python sync_whitelist.py --daemon
DAEMON=0
CHECK_INTERVAL_HOURS=24

COMMIT_ON_CHANGES=1
DRY_RUN=0

# ---- misc ----------------------------------------------------------
GIT_USER=whitelist-bot
GIT_EMAIL=whitelist-bot@users.noreply.github.com
HTTP_TIMEOUT=60
LOG_FILE=
